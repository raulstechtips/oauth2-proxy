{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["infisical", "clientSecret", "configSecret", "ingressRoute", "oauth2-proxy"],
  "definitions": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secretName", "secretPath", "recursive", "refreshInterval", "keys"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string", "minLength": 1},
        "secretPath": {"type": "string", "minLength": 1},
        "recursive": {"type": "boolean"},
        "refreshInterval": {"type": "string", "minLength": 1},
        "keys": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^[-._a-zA-Z0-9]+$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "properties": {
    "global": {"type": "object"},
    "oauth2-proxy": {"type": "object"},
    "infisical": {
      "type": "object", "additionalProperties": false,
      "required": ["authRef", "projectSlug", "environmentSlug"],
      "properties": {
        "authRef": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "namespace"],
          "properties": {
            "name": {"type": "string"},
            "namespace": {"type": "string"}
          }
        },
        "projectSlug": {"type": "string"},
        "environmentSlug": {"type": "string"}
      }
    },
    "clientSecret": {"$ref": "#/definitions/secret"},
    "configSecret": {"$ref": "#/definitions/secret"},
    "ingressRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "entryPoints", "ingressClass", "middlewares", "host", "tlsSecretName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "entryPoints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ingressClass": {"type": "string", "minLength": 1},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "middlewares": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "namespace": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
